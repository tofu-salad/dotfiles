configuration {
        modes: "window,drun,run,ssh";
	font: "mono 12";
        fixed-num-lines: false;
	show-icons: true;
/*	run-command: "{cmd}";*/
        hover-select: true;
        me-select-entry: "";
        me-accept-entry: "MousePrimary";
  timeout {
      action: "kb-cancel";
      delay:  0;
  }
  filebrowser {
      directories-first: true;
      sorting-method:    "name";
  }
}

element {
    padding: 4px ;
    cursor:  pointer;
    spacing: 4px ;
    border:  0;
}
element normal.normal {
    background-color: inherit;
    text-color:       rgba (255, 255, 255, 0.5);
}
element selected.normal {
    background-color: inherit;
    text-color:       white;
    border: 1px;
    border-color: rgba (255, 255, 255, 0.5);
}
element alternate.normal {
    background-color: inherit;
    text-color:       rgba (255, 255, 255, 0.5);
}

element-text {
    background-color: transparent;
    cursor:           inherit;
    highlight:        inherit;
    text-color:       inherit;
}
element-icon {
    background-color: transparent;
    size:             1.0000em ;
    cursor:           inherit;
    text-color:       inherit;
}
window {
    padding:          4;
    background-color: rgba (0, 0, 0, 1);
    border:           1;
    border-color:     rgba (255, 255, 255, 0.5);
    width: 400px;
    max-height: 400px;
}
mainbox {
    padding: 0;
    border:  0;
}

message {
    padding:      1px ;
    border-color: rgba (255, 255, 255, 0.5);
    border:       2px dash 0px 0px ;
}

textbox {
    text-color: white;
}

listview {
    padding:      4px 4px;
    scrollbar:    true;
    border-color: rgba (255, 255, 255, 0.5);
    spacing:      4px ;
    fixed-height: 0;
    border:       1px solid 0px 0px ;
}
scrollbar {
    width:        4px ;
    padding:      0;
    handle-width: 2px ;
    border:       0;
    handle-color: rgba (255, 255, 255, 0.5);
}

num-filtered-rows {
    expand:     false;
    text-color: white;
}

num-rows {
    expand:     false;
    text-color: Gray;
}

textbox-num-sep {
    expand:     false;
    str:        "/";
    text-color: Gray;
}

inputbar {
    padding:    4px ;
    spacing:    0px ;
    text-color: white;
    children:   [ "entry","overlay","num-filtered-rows","textbox-num-sep","num-rows","case-indicator" ];
}

overlay {
    padding:          0px 0.2000em ;
    background-color: inherit;
    foreground-color: inherit;
    margin:           0px 0.2000em ;
    text-color:       rgba (255, 255, 255, 0.5);
}

case-indicator {
    spacing:    0;
    text-color: white;
}

entry {
    spacing:           0;
    placeholder-color: rgba (255, 255, 255, 0.5);
    placeholder:       "filter...";
    text-color: white;
}
prompt {
    spacing:    0;
    text-color: rgba (255, 255, 255, 0.5);
}

textbox-prompt-colon {
    margin:     0px 0.3000em 0.0000em 0.0000em ;
    expand:     false;
    str:        ":";
    text-color: rgba (255, 255, 255, 0.5);
}
